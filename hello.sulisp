(fn main () 
    (begin 
        (assign x 0)
        (handle error 
            (
                (throw (fn handle (err k) (io println err)))
            )
            (io println x)
            (while (< x 4) 
                (begin 
                    (assign x (+ x 1))
                    (io println "Hello there")
                    (error throw :error))))))

(main)